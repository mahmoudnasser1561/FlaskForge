# Copy this file to .env and fill in your own values.
# .env is git-ignored, so real secrets never get committed.
# docker compose (and `flask run`, via python-dotenv) load it automatically.

SECRET_KEY=change-me
FLASKY_ADMIN=admin@example.com

POSTGRES_USER=flaskforge
POSTGRES_PASSWORD=flaskforge
POSTGRES_DB=flaskforge

# Gmail SMTP example: requires a Google Account App Password, not your
# regular password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled first).
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
FLASKY_MAIL_SENDER=

# "Sign in with Google": create an OAuth 2.0 Client ID (Web application)
# at https://console.cloud.google.com/apis/credentials, with an
# authorized redirect URI of http://localhost:5000/auth/google/callback
# (or your real domain in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI content moderation (optional): only needed if you run the
# moderation-agent service (`docker compose --profile moderation up`).
# Generate a random value with: python3 -c "import secrets; print(secrets.token_hex(32))"
MODERATION_SERVICE_TOKEN=
# These two only need to change if you're running multiple independent
# StaffRoom instances sharing one Redis and want to keep them separate.
MODERATION_QUEUE_NAME=moderation_queue
MODERATION_HEARTBEAT_KEY=moderation_agent:heartbeat

# Real classification (also optional, same moderation-agent service):
# an IAM user/role whose credentials have bedrock:InvokeModel and
# bedrock:Converse permission on the BEDROCK_MODEL_ID below is all
# that's required on the AWS side — no separate model-access console
# step exists anymore, serverless models like Nova Micro auto-enable
# on first real use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
