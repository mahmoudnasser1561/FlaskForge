# Copy this file to .env and fill in your own values.
# .env is git-ignored, so real secrets never get committed.
# docker compose (and `flask run`, via python-dotenv) load it automatically.

SECRET_KEY=change-me
FLASKY_ADMIN=admin@example.com

POSTGRES_USER=flaskforge
POSTGRES_PASSWORD=flaskforge
POSTGRES_DB=flaskforge

# Gmail SMTP example: requires a Google Account App Password, not your
# regular password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled first).
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
FLASKY_MAIL_SENDER=

# "Sign in with Google": create an OAuth 2.0 Client ID (Web application)
# at https://console.cloud.google.com/apis/credentials, with an
# authorized redirect URI of http://localhost:5000/auth/google/callback
# (or your real domain in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
